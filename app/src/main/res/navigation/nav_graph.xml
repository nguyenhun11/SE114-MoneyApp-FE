<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.moneyapp.view.home.HomeFragment"
        android:label="@string/home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/transactionFragment"
        android:name="com.example.moneyapp.view.transaction.TransactionFragment"
        android:label="@string/transaction"
        tools:layout="@layout/fragment_transaction" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.moneyapp.view.account.AccountFragment"
        android:label="@string/account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/accountDetailFragment"
        android:name="com.example.moneyapp.view.account.AccountDetailFragment"
        android:label="Account Detail"
        tools:layout="@layout/fragment_account_detail" />

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.moneyapp.view.transaction.TransactionDetailFragment"
        android:label="Chi tiết giao dịch"
        tools:layout="@layout/fragment_transaction_detail" />

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.moneyapp.view.transaction.TransactionAddFragment"
        android:label="Giao dịch mới"
        tools:layout="@layout/fragment_transaction_add" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.moneyapp.view.profile.ProfileFragment"
        android:label="Hồ sơ"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_profileFragment_to_informationFragment"
            app:destination="@id/informationFragment" />
    </fragment>

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.moneyapp.view.profile.ChangePasswordFragment"
        android:label="Thay đổi mật khẩu"
        tools:layout="@layout/fragment_change_password" />

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.moneyapp.view.statistic.StatisticFragment"
        android:label="Thống kê"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.example.moneyapp.view.category.CategoryFragment"
        android:label="Hạng mục"
        tools:layout="@layout/fragment_category">
        <action
            android:id="@+id/action_categoryFragment_to_addCategoryFragment"
            app:destination="@id/addCategoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCategoryFragment"
        android:name="com.example.moneyapp.view.category.AddCategoryFragment"
        android:label="Thêm hạng mục"
        tools:layout="@layout/fragment_category_add">
        <argument
            android:name="type"
            android:defaultValue="2"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.moneyapp.view.setting.SettingFragment"
        android:label="Cài đặt"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/informationFragment"
        android:name="com.example.moneyapp.view.information.InformationFragment"
        android:label="Thông tin"
        tools:layout="@layout/fragment_information" />

</navigation>