<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="end">

    <!-- 1. MÀN HÌNH CHÍNH (NavHost + BottomNav + FAB) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/nav_graph" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurface"
            android:fitsSystemWindows="true"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemPaddingTop="10dp"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_menu" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/fab_add"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_button_gradient"
            android:elevation="4dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/colorOnPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. SIDE MENU (NGĂN KÉO BÊN PHẢI) -->
    <LinearLayout
        android:id="@+id/side_menu_right"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:text="Tiện ích"
            android:textColor="@color/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/btn_statistics"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_goals"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_categories"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_city_menu"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_budget_menu"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_info"
            layout="@layout/item_more_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder" />

        <include
            android:id="@+id/btn_settings"
            layout="@layout/item_more_menu" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>