<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scroll_view_reset"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_reset_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/reset_password_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_reset_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_password_desc"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reset_title" />

        <TextView
            android:id="@+id/tv_label_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="32dp"
            android:text="@string/reset_password_token_hint"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reset_desc" />

        <EditText
            android:id="@+id/et_reset_token"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edittext_selector"
            android:hint="@string/reset_password_token_hint"
            android:gravity="start|center_vertical"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:textColor="@color/colorOnSurface"
            android:textColorHint="@color/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tv_label_token" />

        <TextView
            android:id="@+id/tv_label_new_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/change_password_new"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_reset_token" />

        <FrameLayout
            android:id="@+id/fl_reset_password_wrapper"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label_new_password">

            <EditText
                android:id="@+id/et_reset_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edittext_selector"
                android:hint="@string/password_placeholder"
                android:gravity="start|center_vertical"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:textColor="@color/colorOnSurface"
                android:textColorHint="@color/colorOnSurfaceVariant" />

            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_show_reset_password"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:iiv_color="@color/colorOnSurfaceVariant"
                app:iiv_icon="gmd_visibility_off" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_label_confirm_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/change_password_confirm"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fl_reset_password_wrapper" />

        <FrameLayout
            android:id="@+id/fl_reset_confirm_password_wrapper"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label_confirm_password">

            <EditText
                android:id="@+id/et_reset_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edittext_selector"
                android:hint="@string/password_placeholder"
                android:gravity="start|center_vertical"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:textColor="@color/colorOnSurface"
                android:textColorHint="@color/colorOnSurfaceVariant" />

            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_show_reset_confirm_password"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:iiv_color="@color/colorOnSurfaceVariant"
                app:iiv_icon="gmd_visibility_off" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:text="@string/reset_password_btn"
            android:textAllCaps="false"
            android:textColor="@color/colorSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_gradient"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/fl_reset_confirm_password_wrapper" />

        <TextView
            android:id="@+id/tv_reset_back_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/forgot_password_back_to_login"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_reset_password" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>