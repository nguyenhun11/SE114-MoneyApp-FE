<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Phần nền Gradient cho Header giống các Fragment khác -->
    <View
        android:id="@+id/bg_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_small"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- File Layout Header Title có nút Back -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/layout_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dòng mô tả hướng dẫn cách duyệt -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Các giao dịch dưới đây được tự động phát hiện qua thông báo ngân hàng. Nhấn để duyệt chi tiết hoặc bấm nút để thao tác nhanh."
        android:textSize="13sp"
        android:textColor="@color/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/bg_header" />

    <!-- RecyclerView chứa danh sách giao dịch chờ duyệt -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pending_transactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_description"
        tools:listitem="@layout/item_pending_transaction" />

    <!-- Trạng thái trống (Không có giao dịch chờ duyệt) -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toBottomOf="@id/bg_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:iiv_icon="gmd_info"
            app:iiv_color="@color/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không có giao dịch nào chờ duyệt"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khi nhận được thông báo chi tiêu mới,\ngiao dịch sẽ tự động xuất hiện ở đây."
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/colorOnSurfaceVariant"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
