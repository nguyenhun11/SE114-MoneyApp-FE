<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tab_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Ngày"
                android:textColor="@color/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Tuần"
                android:textColor="@color/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Tháng"
                android:textColor="@color/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Năm"
                android:textColor="@color/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Khoảng thời gian"
                android:textColor="@color/colorOnSurfaceVariant" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:background="@color/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/ll_navigation_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            app:iiv_color="@color/colorOnSurface"
            app:iiv_icon="gmd_keyboard_arrow_left" />

        <Space
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/tv_date_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tháng 3 - 2026"
            android:textColor="@color/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/btn_jump_today"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            app:iiv_color="@color/colorOnSurface"
            app:iiv_icon="gmd_last_page" />

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            app:iiv_color="@color/colorOnSurface"
            app:iiv_icon="gmd_keyboard_arrow_right" />
    </LinearLayout>

</LinearLayout>