<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <View
        android:id="@+id/bg_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_small"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/header_layout"
        layout="@layout/layout_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="@dimen/main_top_margin_small"
        android:layout_marginBottom="@dimen/card_bottom_margin"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:strokeColor="@color/colorBorder"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/InputLabel"
                    android:text="Số tiền ngân sách" />

                <include
                    android:id="@+id/layout_amount"
                    layout="@layout/layout_amount_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/InputLabel"
                    android:layout_marginTop="16dp"
                    android:text="Phạm vi ngân sách" />

                <RadioGroup
                    android:id="@+id/rgScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/rbScopeTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng" />
                    <RadioButton
                        android:id="@+id/rbScopeGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nhóm" />
                    <RadioButton
                        android:id="@+id/rbScopeCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:checked="true"
                        android:text="Hạng mục" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/layoutGroupSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/InputLabel"
                        android:text="Nhóm hạng mục" />

                    <LinearLayout
                        android:id="@+id/btnSelectGroup"
                        style="@style/InputSelectorContainer"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvSelectedGroup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chọn nhóm..."
                            android:textColor="@color/colorOnSurface"
                            android:textSize="15sp" />

                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:iiv_color="@color/colorOnSurfaceVariant"
                            app:iiv_icon="gmd_keyboard_arrow_down"
                            app:iiv_padding="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCategorySelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/InputLabel"
                        android:text="Hạng mục" />

                    <LinearLayout
                        android:id="@+id/btnSelectCategory"
                        style="@style/InputSelectorContainer"
                        android:layout_marginBottom="16dp">

                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivCategoryIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            app:iiv_color="@color/colorOnSurface"
                            app:iiv_icon="gmd_category" />

                        <TextView
                            android:id="@+id/tvSelectedCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chọn hạng mục..."
                            android:textColor="@color/colorOnSurface"
                            android:textSize="15sp" />

                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:iiv_color="@color/colorOnSurfaceVariant"
                            app:iiv_icon="gmd_keyboard_arrow_down"
                            app:iiv_padding="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/InputLabel"
                    android:text="Chu kỳ" />

                <RadioGroup
                    android:id="@+id/rgPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/rbWeekly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tuần" />
                    <RadioButton
                        android:id="@+id/rbMonthly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Tháng" />
                    <RadioButton
                        android:id="@+id/rbYearly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Năm" />
                </RadioGroup>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>