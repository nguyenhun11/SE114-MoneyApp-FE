<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_type_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/colorPrimaryBgLight"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorPrimary"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_type_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/colorPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Tiết kiệm" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/fl_icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/colorInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_icon" android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:iiv_color="@color/white"
                app:iiv_icon="gmd-swap-horiz" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/fl_icon_container"
            app:layout_constraintEnd_toStartOf="@+id/ll_amount_container"
            app:layout_constraintStart_toEndOf="@id/fl_icon_container"
            app:layout_constraintTop_toTopOf="@+id/fl_icon_container">

            <TextView
                android:id="@+id/tvSourceAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Từ: Tiền mặt" />

            <TextView
                android:id="@+id/tvDestAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorOnSurface"
                android:textSize="15sp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Đến: BIDV" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_amount_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/fl_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fl_icon_container">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorInfo"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="100 USD" />

            <TextView
                android:id="@+id/tvBaseAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="≈ 2.500.000 VND"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Ghi chú được đưa xuống dưới cùng, hiển thị in nghiêng giống trang Giao dịch -->
        <TextView
            android:id="@+id/tvNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_icon_container"
            tools:text="Chuyển tiền sinh hoạt tháng này"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/colorBorder" />

</LinearLayout>