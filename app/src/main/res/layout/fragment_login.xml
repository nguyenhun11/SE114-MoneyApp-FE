<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_login_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-48dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/splash_img" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_horizontal_margin"
            android:layout_marginTop="32dp"
            android:text="@string/login_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_login_header" />

        <TextView
            android:id="@+id/tv_label_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_horizontal_margin"
            android:layout_marginTop="20dp"
            android:text="@string/login_username_hint"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_login_title" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/card_horizontal_margin"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edittext_selector"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:hint="@string/login_username_hint"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/colorOnSurface"
            android:textColorHint="@color/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tv_label_email" />

        <TextView
            android:id="@+id/tv_label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_horizontal_margin"
            android:layout_marginTop="12dp"
            android:text="@string/login_password_hint"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_email" />

        <FrameLayout
            android:id="@+id/fl_password_wrapper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/card_horizontal_margin"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label_password">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edittext_selector"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:gravity="start|center_vertical"
                android:hint="@string/password_placeholder"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/colorOnSurface"
                android:textColorHint="@color/colorOnSurfaceVariant" />

            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_show_password"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:iiv_color="@color/colorOnSurfaceVariant"
                app:iiv_icon="gmd_visibility_off" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="48dp"
            android:text="@string/login_forgot_password"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fl_password_wrapper" />

        <TextView
            android:id="@+id/tv_go_to_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_no_account"
            android:textColor="@color/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_forgot_password" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/card_horizontal_margin"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_gradient"
            android:elevation="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:textSize="16sp"
            android:text="@string/login_title"
            android:textColor="@color/colorOnPrimary"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_go_to_register" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/card_horizontal_margin"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/login_google"
            android:textAllCaps="false"
            android:textColor="@color/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimaryBgLight"
            app:cornerRadius="@dimen/button_radius"
            app:icon="@drawable/ic_google_logo"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_login"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>